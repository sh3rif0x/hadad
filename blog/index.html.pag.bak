<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>المدونة | حداد الرياض</title>
    <meta name="description" content="مقالات ونصائح عن أعمال الحدادة والمظلات والساندوتش بانل في الرياض من حداد الرياض.">
    <link rel="icon" href="/assets/logo.png">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/components/header/style.css">
    <link rel="stylesheet" href="/components/footer/style.css">
    <link rel="stylesheet" href="/blog/style.css">
<!-- BRAND:START -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap">
<link rel="stylesheet" href="/brand.css">
<!-- BRAND:END -->
</head>
<body>
    <div id="header"></div>

    <main id="blogPage">

        <section id="blogList" class="blog-list-page">

    <div class="blog-hero">
        <div class="blog-hero-content">
            <span class="blog-eyebrow">مدونة حداد الرياض</span>
            <h1>
                المقالات
                <strong>والنصائح</strong>
            </h1>
            <p>أدلة ونصائح عملية عن الحدادة والمظلات والساندوتش بانل لتختار التنفيذ المناسب لمشروعك.</p>
        </div>
    </div>

    <div class="blog-list-body">
        <div id="blogFilters" class="blog-filters"></div>
        <div id="blogGrid" class="blog-grid"></div>
        <nav id="blogPagination" class="blog-pagination" aria-label="تنقل الصفحات"></nav>
    </div>

</section>

        <section id="blogDetail" class="blog-detail-page" hidden></section>

        <section id="blogNotFound" class="blog-not-found" hidden></section>

    </main>

    <div id="footer"></div>

    <script type="module" src="/blog/script.js"></script>
</body>
</html>
