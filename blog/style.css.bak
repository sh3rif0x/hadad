/* Blog styles. Colors fall back to defaults if main.css has no matching variables. */

#blogPage {
    --b-accent: var(--primary, #d97706);
    --b-text: var(--text, #1f2937);
    --b-muted: #6b7280;
    --b-bg: var(--bg, #ffffff);
    --b-card: #ffffff;
    --b-border: rgba(0, 0, 0, .09);
    --b-radius: 16px;

    min-height: 60vh;
    color: var(--b-text);
}

html { scroll-behavior: smooth; }

.blog-list-page,
.blog-detail-page,
.blog-not-found {
    max-width: 1200px;
    margin: 0 auto;
    padding: 56px 20px 80px;
}

/* ---------- list ---------- */

.blog-list-header { text-align: center; max-width: 700px; margin: 0 auto 32px; }
.blog-list-header span,
.blog-post-category {
    display: inline-block;
    color: var(--b-accent);
    font-weight: 700;
    font-size: .9rem;
    margin-bottom: 8px;
}
.blog-list-header h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0 0 12px; }
.blog-list-header p { color: var(--b-muted); line-height: 1.9; margin: 0; }

.blog-filters { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-bottom: 32px; }
.blog-filter {
    border: 1px solid var(--b-border);
    background: var(--b-card);
    color: inherit;
    padding: 8px 18px;
    border-radius: 999px;
    cursor: pointer;
    font: inherit;
    transition: .2s;
}
.blog-filter:hover { border-color: var(--b-accent); }
.blog-filter.is-active { background: var(--b-accent); border-color: var(--b-accent); color: #fff; }

.blog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }

.blog-card {
    display: flex;
    flex-direction: column;
    background: var(--b-card);
    border: 1px solid var(--b-border);
    border-radius: var(--b-radius);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: transform .25s, box-shadow .25s;
}
.blog-card:hover { transform: translateY(-4px); box-shadow: 0 14px 34px rgba(0, 0, 0, .1); }
.blog-card-image { aspect-ratio: 16 / 10; background: #f3f4f6; overflow: hidden; }
.blog-card-image img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s; }
.blog-card:hover .blog-card-image img { transform: scale(1.05); }
.blog-card-content { display: flex; flex-direction: column; gap: 10px; padding: 20px; flex: 1; }
.blog-card-meta { display: flex; justify-content: space-between; font-size: .82rem; color: var(--b-muted); }
.blog-card-category { color: var(--b-accent); font-weight: 700; }
.blog-card h2 { font-size: 1.15rem; line-height: 1.6; margin: 0; }
.blog-card p { color: var(--b-muted); line-height: 1.8; margin: 0; font-size: .95rem; }
.blog-card-link { margin-top: auto; color: var(--b-accent); font-weight: 700; }
.blog-empty { text-align: center; color: var(--b-muted); grid-column: 1 / -1; }

/* ---------- post ---------- */

.blog-breadcrumb { display: flex; flex-wrap: wrap; gap: 8px; font-size: .88rem; color: var(--b-muted); margin-bottom: 20px; }
.blog-breadcrumb a { color: inherit; text-decoration: none; }
.blog-breadcrumb a:hover { color: var(--b-accent); }

.blog-post-hero { max-width: 900px; margin: 0 auto 40px; }
.blog-post-hero h1 { font-size: clamp(1.7rem, 4vw, 2.5rem); line-height: 1.5; margin: 0 0 16px; }
.blog-post-meta { display: flex; flex-wrap: wrap; gap: 10px; color: var(--b-muted); font-size: .9rem; margin-bottom: 24px; }
.blog-post-image { border-radius: var(--b-radius); overflow: hidden; background: #f3f4f6; aspect-ratio: 16 / 8; }
.blog-post-image img { width: 100%; height: 100%; object-fit: cover; display: block; }

.blog-post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 48px;
    max-width: 1100px;
    margin: 0 auto;
}
/* RTL: first column (article) sits on the right, TOC on the left */

.blog-post-aside { order: 2; }
.blog-toc {
    position: sticky;
    top: 100px;
    border: 1px solid var(--b-border);
    border-radius: var(--b-radius);
    padding: 20px;
    background: var(--b-card);
}
.blog-toc strong { display: block; margin-bottom: 12px; }
.blog-toc ol { margin: 0; padding: 0 18px 0 0; display: grid; gap: 10px; }
.blog-toc a { color: var(--b-muted); text-decoration: none; line-height: 1.6; font-size: .93rem; }
.blog-toc a:hover { color: var(--b-accent); }

.blog-post-body { font-size: 1.05rem; line-height: 2; }
.blog-post-excerpt {
    font-size: 1.15rem;
    color: var(--b-muted);
    border-inline-start: 4px solid var(--b-accent);
    padding-inline-start: 16px;
    margin: 0 0 32px;
}
.blog-section { margin-bottom: 36px; scroll-margin-top: 100px; }
.blog-section h2 { display: flex; align-items: center; gap: 12px; font-size: 1.5rem; line-height: 1.5; margin: 0 0 14px; }
.blog-section h2 span { color: var(--b-accent); font-size: 1rem; font-weight: 800; }
.blog-section p { margin: 0 0 14px; }
.blog-section ul { margin: 0 0 14px; padding: 0; list-style: none; display: grid; gap: 10px; }
.blog-section li { position: relative; padding-inline-start: 28px; }
.blog-section li::before { content: "✓"; position: absolute; inset-inline-start: 0; color: var(--b-accent); font-weight: 800; }

.blog-faq { margin: 48px 0; }
.blog-faq h2 { font-size: 1.5rem; margin: 0 0 16px; }
.blog-faq-item { border: 1px solid var(--b-border); border-radius: 12px; padding: 4px 18px; margin-bottom: 10px; background: var(--b-card); }
.blog-faq-item summary { cursor: pointer; font-weight: 700; padding: 14px 0; }
.blog-faq-item p { margin: 0 0 14px; color: var(--b-muted); }

.blog-cta { background: #111827; color: #fff; border-radius: var(--b-radius); padding: 32px; text-align: center; }
.blog-cta h2 { font-size: 1.3rem; line-height: 1.8; margin: 0 0 20px; }
.blog-cta-buttons { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
.blog-btn { display: inline-block; padding: 12px 28px; border-radius: 999px; font-weight: 700; text-decoration: none; transition: .2s; }
.blog-btn-primary { background: var(--b-accent); color: #fff; }
.blog-btn-secondary { border: 1px solid rgba(255, 255, 255, .5); color: #fff; }
.blog-btn:hover { transform: translateY(-2px); opacity: .92; }

.blog-related { max-width: 1100px; margin: 64px auto 0; }
.blog-related h2 { font-size: 1.5rem; margin: 0 0 20px; }

/* ---------- 404 ---------- */

.blog-not-found { text-align: center; padding-top: 100px; }
.blog-not-found span { display: block; font-size: 5rem; font-weight: 800; color: var(--b-accent); line-height: 1; }
.blog-not-found h1 { margin: 12px 0; }
.blog-not-found p { color: var(--b-muted); }
.blog-not-found a { display: inline-block; margin-top: 16px; color: var(--b-accent); font-weight: 700; }

/* ---------- responsive ---------- */

@media (max-width: 900px) {
    .blog-post-layout { grid-template-columns: 1fr; gap: 24px; }
    .blog-post-aside { order: 0; }
    .blog-toc { position: static; }
}
@media (max-width: 600px) {
    .blog-list-page, .blog-detail-page, .blog-not-found { padding: 36px 16px 60px; }
    .blog-grid { grid-template-columns: 1fr; }
    .blog-cta { padding: 24px 18px; }
}
