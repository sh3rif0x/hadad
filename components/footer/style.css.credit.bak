/* =========================================================
   FOOTER
========================================================= */

.site-footer {
    padding: 85px clamp(24px, 8vw, 140px) 25px;
    background: #0f1530;
    color: #ffffff;
}


/* =========================================================
   FOOTER CONTENT
========================================================= */

.footer-content {
    display: grid;
    grid-template-columns: minmax(240px, 1.4fr) minmax(150px, .8fr) minmax(190px, 1fr) minmax(230px, 1fr);
    gap: 55px;
}


/* =========================================================
   BRAND
========================================================= */

.footer-brand {
    max-width: 360px;
}

.footer-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
}

.footer-logo img {
    display: block;
    width: auto;
    max-width: 190px;
    max-height: 70px;
    object-fit: contain;
}

.footer-description {
    max-width: 350px;
    margin-top: 25px;
    color: #7e8b94;
    font-size: 15px;
    line-height: 2;
}

.footer-location {
    margin-top: 24px;
    color: #a5afb6;
    font-size: 14px;
}


/* =========================================================
   COLUMN
========================================================= */

.footer-title {
    margin: 0 0 25px;
    color: #ffffff;
    font-size: 17px;
    font-weight: 800;
    line-height: 1.4;
}


/* =========================================================
   LINKS
========================================================= */

.footer-links {
    display: flex;
    flex-direction: column;
    gap: 11px;
}

.footer-links a {
    width: fit-content;
    color: #7e8b94;
    font-size: 14px;
    line-height: 1.6;
    text-decoration: none;
    transition: color .25s ease, transform .25s ease;
}

.footer-links a:hover {
    color: #dd9a3b;
    transform: translateX(-4px);
}


/* =========================================================
   CONTACT
========================================================= */

.footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: 22px;
}

.footer-contact-item {
    display: flex;
    flex-direction: column;
    gap: 5px;
    color: #8d99a2;
    font-size: 14px;
    line-height: 1.7;
    text-decoration: none;
}

a.footer-contact-item {
    transition: color .25s ease;
}

a.footer-contact-item:hover {
    color: #dd9a3b;
}

.footer-contact-label {
    color: #5f6c75;
    font-size: 12px;
}

.footer-contact-item strong {
    color: #dd9a3b;
    font-size: 18px;
    font-weight: 800;
}


/* =========================================================
   FOOTER BOTTOM
========================================================= */

.footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 65px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, .1);
    color: #68747d;
    font-size: 12px;
    line-height: 1.6;
}


/* =========================================================
   TABLET
   2 COLUMNS × 2 ROWS
========================================================= */

@media (max-width: 1050px) {
    .site-footer {
        padding-inline: 40px;
    }
    .footer-content {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 55px 45px;
    }
    .footer-brand {
        max-width: 420px;
    }
}


/* =========================================================
   MOBILE
   1 COLUMN
========================================================= */

@media (max-width: 650px) {
    .site-footer {
        padding: 65px 22px 22px;
    }
    .footer-content {
        grid-template-columns: 1fr;
        gap: 45px;
    }
    .footer-brand {
        max-width: 100%;
    }
    .footer-description {
        max-width: 100%;
    }
    .footer-title {
        margin-bottom: 20px;
    }
    .footer-bottom {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        margin-top: 50px;
    }
}


/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 400px) {
    .site-footer {
        padding-inline: 18px;
    }
    .footer-logo img {
        max-width: 160px;
    }
    .footer-description {
        font-size: 14px;
    }
    .footer-links a {
        font-size: 13px;
    }
}