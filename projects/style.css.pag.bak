/* =========================================================
   PROJECTS PAGE
========================================================= */

.projects-hero {
    position: relative;
    min-height: 620px;
    display: flex;
    align-items: flex-end;
    padding: 150px clamp(24px, 8vw, 140px) 90px;
    overflow: hidden;
    background: linear-gradient( rgba(27, 38, 69, 0.72), rgba(27, 38, 69, 0.88)), url("../assets/banner.png") center / cover no-repeat;
}

.projects-hero-content {
    max-width: 850px;
}

.projects-eyebrow {
    display: inline-block;
    margin-bottom: 22px;
    color: #f2c98a;
    font-size: 15px;
    font-weight: 800;
}

.projects-hero h1 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(50px, 7vw, 90px);
    line-height: 1;
    font-weight: 900;
}

.projects-hero h1 strong {
    display: block;
    color: #f2c98a;
}

.projects-hero-content p {
    max-width: 680px;
    margin-top: 30px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 18px;
    line-height: 2;
}


/* =========================================================
   PROJECTS SECTION
========================================================= */

.projects-page {
    padding: 120px clamp(24px, 8vw, 140px);
    background: var(--color-bg);
}

.projects-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 60px;
    margin-bottom: 55px;
}

.projects-heading>div {
    flex-shrink: 0;
}

.projects-heading>div>span {
    color: var(--color-primary);
    font-size: 15px;
    font-weight: 900;
}

.projects-heading h2 {
    margin-top: 15px;
    color: var(--color-text-dark);
    font-size: clamp(42px, 5vw, 68px);
    line-height: 1.1;
    font-weight: 900;
}

.projects-heading h2 strong {
    color: var(--color-primary);
}

.projects-heading>p {
    max-width: 480px;
    color: var(--color-text-medium);
    font-size: 17px;
    line-height: 2;
}


/* =========================================================
   FILTERS
========================================================= */

.projects-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 35px;
}

.project-filter {
    min-height: 48px;
    padding: 0 22px;
    border: 1px solid var(--color-border);
    border-radius: 30px;
    background: #ffffff;
    color: var(--color-text);
    font-size: 15px;
    font-weight: 800;
    transition: 0.25s ease;
}

.project-filter:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
}

.project-filter.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #ffffff;
}


/* =========================================================
   PROJECT GRID
========================================================= */

.projects-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
}


/* =========================================================
   PROJECT CARD
========================================================= */

.project-card {
    position: relative;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
}

.project-card:hover {
    transform: translateY(-7px);
    box-shadow: var(--shadow-lg);
}


/* =========================================================
   IMAGE
========================================================= */

.project-card-image {
    position: relative;
    height: 380px;
    overflow: hidden;
    background: var(--color-bg-soft);
}

.project-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
}

.project-card:hover .project-card-image img {
    transform: scale(1.06);
}


/* =========================================================
   IMAGE OVERLAY
========================================================= */

.project-card-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient( to top, rgba(20, 28, 54, 0.55), transparent 55%);
    opacity: 0;
    transition: opacity 0.35s ease;
}

.project-card:hover .project-card-image::after {
    opacity: 1;
}


/* =========================================================
   CATEGORY
========================================================= */

.project-category {
    position: absolute;
    top: 18px;
    right: 18px;
    z-index: 2;
    padding: 7px 13px;
    border-radius: 20px;
    background: rgba(27, 38, 69, 0.88);
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    backdrop-filter: blur(8px);
}


/* =========================================================
   CARD CONTENT
========================================================= */

.project-card-content {
    padding: 25px;
}

.project-number {
    display: block;
    margin-bottom: 12px;
    color: var(--color-primary);
    font-size: 13px;
    font-weight: 900;
}

.project-card h3 {
    color: var(--color-text-dark);
    font-size: 24px;
    line-height: 1.3;
    font-weight: 900;
}

.project-card p {
    margin-top: 12px;
    color: var(--color-text-medium);
    font-size: 15px;
    line-height: 1.9;
}


/* =========================================================
   EMPTY STATE
========================================================= */

.projects-empty {
    grid-column: 1 / -1;
    padding: 80px 20px;
    text-align: center;
    color: var(--color-text-medium);
}


/* =========================================================
   CTA
========================================================= */

.projects-cta {
    padding: 110px clamp(24px, 8vw, 140px);
    background: var(--color-bg-dark);
}

.projects-cta-content {
    max-width: 850px;
}

.projects-cta-content>span {
    color: #f2c98a;
    font-size: 15px;
    font-weight: 800;
}

.projects-cta h2 {
    margin-top: 18px;
    color: #ffffff;
    font-size: clamp(42px, 5vw, 68px);
    line-height: 1.1;
}

.projects-cta h2 strong {
    color: #f2c98a;
}

.projects-cta p {
    max-width: 650px;
    margin-top: 25px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 17px;
    line-height: 2;
}

.projects-cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1000px) {
    .projects-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .projects-heading {
        align-items: flex-start;
        flex-direction: column;
        gap: 20px;
    }
}

@media (max-width: 650px) {
    .projects-hero {
        min-height: 520px;
        padding: 130px 22px 70px;
    }
    .projects-hero h1 {
        font-size: 48px;
    }
    .projects-hero-content p {
        font-size: 16px;
    }
    .projects-page {
        padding: 80px 22px;
    }
    .projects-heading h2 {
        font-size: 42px;
    }
    .projects-grid {
        grid-template-columns: 1fr;
    }
    .project-card-image {
        height: 320px;
    }
    .projects-filters {
        gap: 8px;
    }
    .project-filter {
        min-height: 44px;
        padding: 0 17px;
        font-size: 14px;
    }
    .projects-cta {
        padding: 80px 22px;
    }
    .projects-cta h2 {
        font-size: 42px;
    }
    .projects-cta-buttons {
        flex-direction: column;
    }
    .projects-cta-buttons a {
        width: 100%;
    }
}