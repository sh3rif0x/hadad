/* =========================================================
   CONTACT PAGE
   uses variables from /main.css
========================================================= */

.ct-hero,
.ct-channels,
.ct-topics,
.ct-info,
.ct-steps,
.ct-map {
    padding-inline: clamp(22px, 8vw, 140px);
}

/* ---------- HERO ---------- */

.ct-hero {
    display: flex;
    align-items: flex-end;
    min-height: 520px;
    padding-top: 150px;
    padding-bottom: 130px;
    background:
        linear-gradient(rgba(18, 56, 75, .78), rgba(18, 56, 75, .92)),
        url("/assets/banner.png") center / cover no-repeat;
}

.ct-hero-inner { max-width: 820px; }

.ct-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, .25);
    border-radius: 40px;
    background: rgba(255, 255, 255, .08);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    backdrop-filter: blur(8px);
}

.ct-badge i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #3ddc84;
    box-shadow: 0 0 0 0 rgba(61, 220, 132, .6);
    animation: ctPulse 2s infinite;
}

@keyframes ctPulse {
    70% { box-shadow: 0 0 0 10px rgba(61, 220, 132, 0); }
    100% { box-shadow: 0 0 0 0 rgba(61, 220, 132, 0); }
}

.ct-hero h1 {
    margin-top: 26px;
    color: #fff;
    font-size: clamp(42px, 6.4vw, 84px);
    font-weight: 900;
    line-height: 1.1;
}

.ct-hero h1 strong {
    display: block;
    color: var(--color-accent-light);
}

.ct-hero p {
    max-width: 620px;
    margin-top: 24px;
    color: rgba(255, 255, 255, .8);
    font-size: 18px;
    line-height: 2;
}

/* ---------- CHANNELS ---------- */

.ct-channels {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    margin-top: -70px;
}

.ct-card {
    display: flex;
    flex-direction: column;
    padding: 40px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 24px;
    box-shadow: var(--shadow-lg);
}

.ct-card-wa { border-top: 5px solid #25d366; }
.ct-card-ph { border-top: 5px solid var(--color-primary); }

.ct-card-icon {
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    border-radius: 20px;
    color: #fff;
}

.ct-card-wa .ct-card-icon { background: #25d366; }
.ct-card-ph .ct-card-icon { background: var(--color-primary); }

.ct-card-icon svg { width: 34px; height: 34px; fill: currentColor; }

.ct-card h2 {
    margin-top: 26px;
    color: var(--color-text-dark);
    font-size: 34px;
    font-weight: 900;
}

.ct-card > p {
    margin-top: 10px;
    color: var(--color-text-medium);
    font-size: 16px;
    line-height: 1.9;
}

.ct-number {
    display: block;
    margin-top: 24px;
    color: var(--color-text-dark);
    font-size: clamp(30px, 3.4vw, 44px);
    font-weight: 900;
    letter-spacing: 1px;
    text-align: right;
    transition: color .25s ease;
}

.ct-card-wa .ct-number:hover { color: #159a4a; }
.ct-card-ph .ct-number:hover { color: var(--color-primary); }

.ct-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: auto;
    padding-top: 28px;
}

.ct-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 28px;
    border: 1px solid transparent;
    border-radius: 12px;
    font-size: 17px;
    font-weight: 800;
    cursor: pointer;
    transition: transform .25s ease, background-color .25s ease, color .25s ease, border-color .25s ease;
}

.ct-btn:hover { transform: translateY(-2px); }

.ct-btn-wa { flex: 1; color: #fff; background: #25d366; }
.ct-btn-wa:hover { background: #1ebe5a; }

.ct-btn-ph { flex: 1; color: #fff; background: var(--color-primary); }
.ct-btn-ph:hover { background: var(--color-primary-dark); }

.ct-btn-ghost {
    color: var(--color-text-dark);
    background: transparent;
    border-color: var(--color-border);
}

.ct-btn-ghost:hover { border-color: var(--color-primary); color: var(--color-primary); }

/* ---------- TOPICS ---------- */

.ct-topics { padding-top: 100px; padding-bottom: 20px; }

.ct-topics-head h2 {
    color: var(--color-text-dark);
    font-size: clamp(30px, 3.6vw, 46px);
    font-weight: 900;
}

.ct-topics-head p {
    max-width: 560px;
    margin-top: 10px;
    color: var(--color-text-medium);
    font-size: 17px;
    line-height: 1.9;
}

.ct-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
}

.ct-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 22px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 40px;
    color: var(--color-text);
    font-size: 16px;
    font-weight: 700;
    transition: background-color .25s ease, color .25s ease, border-color .25s ease, transform .25s ease;
}

.ct-chip svg { width: 18px; height: 18px; fill: #25d366; transition: fill .25s ease; }

.ct-chip:hover {
    background: #25d366;
    border-color: #25d366;
    color: #fff;
    transform: translateY(-2px);
}

.ct-chip:hover svg { fill: #fff; }

/* ---------- INFO ---------- */

.ct-info {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: 70px;
    padding-block: 10px;
}

.ct-info-item {
    padding: 8px 28px;
    border-inline-start: 1px solid var(--color-border);
}

.ct-info-item:first-child { border-inline-start: 0; padding-inline-start: 0; }

.ct-info-item span {
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 800;
}

.ct-info-item strong {
    display: block;
    margin-top: 8px;
    color: var(--color-text-dark);
    font-size: 22px;
    font-weight: 900;
}

.ct-info-item p {
    margin-top: 6px;
    color: var(--color-text-medium);
    font-size: 15px;
    line-height: 1.8;
}

/* ---------- STEPS ---------- */

.ct-steps {
    margin-top: 90px;
    padding-block: 90px;
    background: var(--color-bg-dark);
}

.ct-steps h2 {
    color: #fff;
    font-size: clamp(30px, 3.6vw, 46px);
    font-weight: 900;
}

.ct-steps ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-top: 40px;
}

.ct-steps li {
    display: flex;
    gap: 16px;
    padding: 24px;
    background: rgba(255, 255, 255, .05);
    border: 1px solid rgba(255, 255, 255, .12);
    border-radius: 16px;
}

.ct-steps li b {
    flex: none;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-accent-light);
    color: var(--color-bg-dark);
    font-weight: 900;
}

.ct-steps h3 { color: #fff; font-size: 18px; font-weight: 800; }

.ct-steps li p {
    margin-top: 6px;
    color: rgba(255, 255, 255, .68);
    font-size: 14.5px;
    line-height: 1.8;
}

/* ---------- MAP ---------- */

.ct-map { padding-block: 0 100px; margin-top: 70px; }

.ct-map iframe {
    display: block;
    width: 100%;
    height: 420px;
    border: 1px solid var(--color-border);
    border-radius: 24px;
}

/* ---------- TOAST ---------- */

.ct-toast {
    position: fixed;
    bottom: 28px;
    left: 50%;
    z-index: 10000;
    padding: 14px 26px;
    border-radius: 40px;
    background: var(--color-bg-dark);
    color: #fff;
    font-weight: 700;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 20px);
    transition: opacity .3s ease, transform .3s ease;
}

.ct-toast.show { opacity: 1; transform: translate(-50%, 0); }

/* ---------- RESPONSIVE ---------- */

@media (max-width: 1000px) {
    .ct-steps ol { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ct-info { grid-template-columns: 1fr; gap: 24px; }
    .ct-info-item,
    .ct-info-item:first-child { padding: 0; border: 0; }
}

@media (max-width: 760px) {
    .ct-channels { grid-template-columns: 1fr; }
}

@media (max-width: 650px) {
    .ct-hero { min-height: 480px; padding-top: 120px; padding-bottom: 110px; }
    .ct-hero p { font-size: 16px; }
    .ct-card { padding: 28px 22px; }
    .ct-actions { flex-direction: column; }
    .ct-btn { width: 100%; }
    .ct-topics { padding-top: 70px; }
    .ct-steps ol { grid-template-columns: 1fr; }
    .ct-map iframe { height: 320px; border-radius: 16px; }
}

@media (prefers-reduced-motion: reduce) {
    .ct-badge i { animation: none; }
    .ct-btn, .ct-chip, .ct-toast { transition: none; }
}
