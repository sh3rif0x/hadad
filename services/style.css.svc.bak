/* =========================================================
   SERVICES LIST
========================================================= */

.services-list-page {

    min-height: 100vh;

    padding:
        150px
        clamp(22px, 6vw, 100px)
        100px;

    background: #faf9f6;
}


.services-list-header {

    max-width: 900px;

    margin:
        0 auto 60px;

    text-align: center;
}


.services-list-header span {

    display: block;

    margin-bottom: 14px;

    color: #dd9a3b;

    font-size: 15px;

    font-weight: 900;
}


.services-list-header h1 {

    margin: 0 0 18px;

    color: #1b2645;

    font-size:
        clamp(42px, 6vw, 76px);

    line-height: 1;

    font-weight: 900;
}


.services-list-header p {

    max-width: 700px;

    margin: 0 auto;

    color: #8a92a3;

    font-size: 18px;

    line-height: 1.9;
}


/* =========================================================
   GRID
========================================================= */

.services-grid {

    width: min(
        1400px,
        100%
    );

    margin: 0 auto;

    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 26px;
}


/* =========================================================
   CARD
========================================================= */

.service-card {

    display: block;

    overflow: hidden;

    background: #ffffff;

    border:
        1px solid
        rgba(27, 38, 69, .10);

    border-radius: 24px;

    color: inherit;

    text-decoration: none;

    box-shadow:
        0 16px 45px
        rgba(27, 38, 69, .08);

    transition:
        transform .3s ease,
        box-shadow .3s ease;
}


.service-card:hover {

    transform:
        translateY(-7px);

    box-shadow:
        0 25px 60px
        rgba(27, 38, 69, .14);
}


.service-card-image {

    height: 270px;

    overflow: hidden;

    background: #1b2645;
}


.service-card-image img {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;

    transition:
        transform .5s ease;
}


.service-card:hover
.service-card-image img {

    transform: scale(1.05);
}


.service-card-content {

    padding: 28px;
}


.service-card-number {

    display: block;

    margin-bottom: 12px;

    color: #dd9a3b;

    font-size: 13px;

    font-weight: 900;
}


.service-card-content h2 {

    margin: 0 0 12px;

    color: #1b2645;

    font-size: 25px;

    font-weight: 900;
}


.service-card-content p {

    min-height: 70px;

    margin: 0 0 20px;

    color: #8a92a3;

    line-height: 1.8;
}


.service-card-link {

    color: #dd9a3b;

    font-weight: 900;
}


/* =========================================================
   DETAIL HERO
========================================================= */

.service-hero {

    position: relative;

    min-height: 720px;

    display: flex;

    align-items: flex-end;

    overflow: hidden;

    background: #1b2645;
}


.service-hero-image {

    position: absolute;

    inset: 0;

    z-index: 0;
}


.service-hero-image img {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;
}


.service-hero-overlay {

    position: absolute;

    inset: 0;

    z-index: 1;

    background:
        linear-gradient(
            180deg,
            rgba(20, 28, 54, .08),
            rgba(20, 28, 54, .86)
        );
}


.service-hero-content {

    position: relative;

    z-index: 2;

    width: min(
        1440px,
        calc(100% - 48px)
    );

    margin: 0 auto;

    padding:
        180px 0 90px;
}


.service-eyebrow {

    display: inline-block;

    margin-bottom: 20px;

    color: #f2c98a;

    font-size: 15px;

    font-weight: 900;
}


.service-hero h1 {

    max-width: 850px;

    margin: 0 0 25px;

    color: #ffffff;

    font-size:
        clamp(52px, 7vw, 92px);

    line-height: 1;

    font-weight: 900;
}


.service-hero p {

    max-width: 800px;

    margin: 0 0 30px;

    color: rgba(255,255,255,.82);

    font-size: 20px;

    line-height: 1.9;
}


/* =========================================================
   BUTTONS
========================================================= */

.service-buttons,
.article-cta-buttons {

    display: flex;

    flex-wrap: wrap;

    gap: 14px;
}


.service-btn {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-height: 54px;

    padding:
        0 28px;

    border-radius: 12px;

    text-decoration: none;

    font-weight: 900;

    transition:
        transform .25s ease,
        opacity .25s ease;
}


.service-btn:hover {

    transform:
        translateY(-2px);

    opacity: .9;
}


.service-btn-primary {

    background: #dd9a3b;

    color: #ffffff;
}


.service-btn-secondary {

    background: #ffffff;

    color: #1b2645;
}


/* =========================================================
   DETAIL CONTENT
========================================================= */

.service-content {

    padding:
        110px
        clamp(22px, 6vw, 100px);

    background: #faf9f6;
}


.service-layout {

    width: min(
        1400px,
        100%
    );

    margin: 0 auto;

    display: grid;

    grid-template-columns:
        minmax(320px, 42%)
        minmax(0, 1fr);

    gap:
        clamp(40px, 7vw, 100px);

    align-items: start;
}


/* =========================================================
   STICKY IMAGE
========================================================= */

.service-sticky {

    position: sticky;

    top: 110px;

    align-self: start;
}


.service-sticky-image {

    overflow: hidden;

    border-radius: 24px;

    background: #1b2645;

    box-shadow:
        0 25px 60px
        rgba(27, 38, 69, .13);
}


.service-sticky-image img {

    width: 100%;

    height: 520px;

    display: block;

    object-fit: cover;
}


.service-sticky-caption {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    padding: 18px 4px;
}


.service-sticky-caption span {

    color: #8a92a3;

    font-size: 13px;
}


.service-sticky-caption strong {

    color: #1b2645;

    font-size: 18px;
}


/* =========================================================
   ARTICLE
========================================================= */

.service-article {

    min-width: 0;

    color: #1b2645;
}


.article-header {

    margin-bottom: 60px;
}


.article-label {

    display: inline-block;

    margin-bottom: 15px;

    color: #dd9a3b;

    font-weight: 900;
}


.article-header h2 {

    margin: 0 0 20px;

    color: #1b2645;

    font-size:
        clamp(34px, 4vw, 58px);

    line-height: 1.15;

    font-weight: 900;
}


.article-header p {

    margin: 0;

    color: #8a92a3;

    font-size: 19px;

    line-height: 2;
}


/* =========================================================
   ARTICLE SECTION
========================================================= */

.article-section {

    display: grid;

    grid-template-columns: 70px 1fr;

    gap: 25px;

    padding:
        35px 0;

    border-bottom:
        1px solid
        rgba(27, 38, 69, .10);
}


.article-number {

    color: #dd9a3b;

    font-size: 15px;

    font-weight: 900;
}


.article-section-content h3 {

    margin: 0 0 12px;

    color: #1b2645;

    font-size: 28px;

    font-weight: 900;
}


.article-section-content p {

    margin: 0;

    color: #8a92a3;

    font-size: 17px;

    line-height: 2;
}


/* =========================================================
   FAQ
========================================================= */

.service-faq {

    padding-top: 70px;
}


.faq-heading {

    margin-bottom: 30px;
}


.faq-heading span {

    color: #dd9a3b;

    font-size: 14px;

    font-weight: 900;
}


.faq-heading h2 {

    margin-top: 10px;

    color: #1b2645;

    font-size: 38px;

    font-weight: 900;
}


.faq-list {

    display: grid;

    gap: 12px;
}


.faq-item {

    padding: 22px;

    background: #ffffff;

    border:
        1px solid
        rgba(27, 38, 69, .10);

    border-radius: 16px;
}


.faq-item summary {

    display: flex;

    align-items: center;

    gap: 18px;

    cursor: pointer;

    list-style: none;
}


.faq-item summary::-webkit-details-marker {

    display: none;
}


.faq-item summary span {

    color: #dd9a3b;

    font-size: 13px;

    font-weight: 900;
}


.faq-item summary strong {

    color: #1b2645;

    font-size: 17px;
}


.faq-item p {

    margin:
        20px 0 0;

    padding-top: 20px;

    border-top:
        1px solid
        rgba(27, 38, 69, .08);

    color: #8a92a3;

    line-height: 2;
}


/* =========================================================
   CTA
========================================================= */

.article-cta {

    margin-top: 70px;

    padding: 35px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 30px;

    background: #1b2645;

    border-radius: 24px;
}


.article-cta span {

    color: #f2c98a;

    font-size: 14px;

    font-weight: 900;
}


.article-cta h2 {

    margin:
        10px 0;

    color: #ffffff;

    font-size: 30px;
}


.article-cta p {

    margin: 0;

    color: rgba(255,255,255,.70);

    line-height: 1.8;
}


/* =========================================================
   404
========================================================= */

.service-not-found {

    min-height: 80vh;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;

    padding: 100px 22px;

    background: #faf9f6;
}


.service-not-found span {

    color: #dd9a3b;

    font-size: 80px;

    font-weight: 900;
}


.service-not-found h1 {

    margin:
        10px 0 15px;

    color: #1b2645;

    font-size: 42px;
}


.service-not-found p {

    color: #8a92a3;

    margin-bottom: 25px;
}


.service-not-found a {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-height: 52px;

    padding: 0 25px;

    border-radius: 10px;

    background: #dd9a3b;

    color: #ffffff;

    text-decoration: none;

    font-weight: 900;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1000px) {

    .services-grid {

        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }


    .service-layout {

        grid-template-columns: 1fr;
    }


    .service-sticky {

        position: relative;

        top: auto;

        order: -1;
    }


    .service-sticky-image img {

        height: 450px;
    }


    .article-cta {

        flex-direction: column;

        align-items: flex-start;
    }

}


@media (max-width: 650px) {

    .services-grid {

        grid-template-columns: 1fr;
    }


    .services-list-page {

        padding-top: 120px;
    }


    .service-hero {

        min-height: 650px;
    }


    .service-hero-content {

        width:
            calc(100% - 36px);

        padding-bottom: 55px;
    }


    .service-hero h1 {

        font-size: 48px;
    }


    .service-buttons {

        flex-direction: column;

        align-items: stretch;
    }


    .service-btn {

        width: 100%;
    }


    .article-section {

        grid-template-columns: 1fr;

        gap: 10px;
    }


    .article-cta {

        padding: 25px;
    }

}
